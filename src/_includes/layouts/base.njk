<!doctype html>
<html lang="fr" data-bs-theme="auto">
<head>
    {% include "partials/header.njk" %}
</head>
{% include "partials/body.njk" %}
    {% include "partials/icons.html" %}
    {% include "partials/docs-navbar.njk" %}

        {% block content %} 
            {{ content | safe }}
        {% endblock %}

<script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
<script>
    mermaid.initialize({
        startOnLoad: true,
        theme: 'default'
    });
</script>
<script>
function verifierQcm(id, answer) {
    const selected = document.querySelector(`input[name="${id}"]:checked`);
    const feedback = document.getElementById(`${id}-feedback`);
    if (!selected) {
        feedback.innerHTML = '<div class="alert alert-warning py-1 mb-0">Veuillez sélectionner une réponse.</div>';
        return;
    }
    if (selected.value === answer) {
        feedback.innerHTML = '<div class="alert alert-success py-1 mb-0">✅ Bonne réponse !</div>';
    } else {
        feedback.innerHTML = `<div class="alert alert-danger py-1 mb-0">❌ Incorrect. La bonne réponse est : <strong>${answer}</strong></div>`;
    }
}
</script>
</body>
</html>
